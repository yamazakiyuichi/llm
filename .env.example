# ================================================================
# ローカルAI システム設定テンプレート
# このファイルをコピーして .env を作成してください:
#   cp .env.example .env
# ================================================================

# ── Ollama ──────────────────────────────────────────────────────
OLLAMA_HOST=0.0.0.0
OLLAMA_PORT=11434

# ── デフォルトモデル ────────────────────────────────────────────
# CPU-only環境では Q4_K_M 量子化モデルを推奨（RAM使用量が少ない）
# チャット用モデル（例: llama3.2:3b-instruct-q4_K_M, mistral:7b-instruct-q4_K_M）
DEFAULT_CHAT_MODEL=llama3.2:3b-instruct-q4_K_M

# ビジョン（画像解析）用モデル
DEFAULT_VISION_MODEL=llava:7b-v1.6-mistral-q4_K_M

# 追加でダウンロードするモデル（スペース区切り）
EXTRA_MODELS=

# ── Open WebUI ──────────────────────────────────────────────────
WEBUI_PORT=3000

# 必ず変更してください（英数字32文字以上推奨）
# setup.sh が自動生成する場合はそのまま使用可能
WEBUI_SECRET_KEY=change_me_before_first_run

# 認証を有効にする（true推奨）
WEBUI_AUTH=true

# ── RAG（ドキュメント検索）設定 ─────────────────────────────────
RAG_EMBEDDING_MODEL=nomic-embed-text:latest
CHUNK_SIZE=1000
CHUNK_OVERLAP=100

# ── スクリーンショット解析 ──────────────────────────────────────
SCREENSHOT_VISION_MODEL=llava:7b-v1.6-mistral-q4_K_M
SCREENSHOT_PROMPT=Describe everything visible in this screenshot in detail. If there is text, transcribe it accurately.
OLLAMA_API_BASE=http://localhost:11434

# ── Rapport/ドキュメントインポート ──────────────────────────────
# Open WebUI管理画面で発行: Settings > Account > API Keys
# import_rapport.py 初回実行時に案内が表示されます
WEBUI_API_KEY=

# ── システム ────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=local-ai
